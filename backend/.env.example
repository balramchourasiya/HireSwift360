# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_HOURS=8
DATABASE_URL=postgresql+psycopg://hireswift:change-me@localhost:5432/hireswift
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Optional SMTP settings for interview invitations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_SSL=false
